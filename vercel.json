{
  "rewrites": [{ "source": "/((?!assets/|og-image.jpg|favicon|apple-touch-icon.png|robots.txt|sitemap.xml|placeholder.svg).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
